@page "/HopDong/GiaHan/{id:int}"
@model QuanLyNhaTro.Pages.HopDong.GiaHanModel
@{ ViewData["Title"] = "Gia hạn hợp đồng"; }

<p>Gia hạn HĐ phòng <strong>@Model.HopDong?.Phong.TenPhong</strong></p>
<form method="post">
    <div asp-validation-summary="All" class="text-danger"></div>
    <p class="mb-3">
        <label class="form-label">Ngày kết thúc mới</label>
        <input asp-for="NgayKetThucMoi" type="date" class="form-control" />
    </p>
    <button type="submit" class="btn btn-primary">Gia hạn</button>
</form>
