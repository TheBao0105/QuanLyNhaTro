@page "/DichVu"
@model QuanLyNhaTro.Pages.DichVu.IndexModel
@{ ViewData["Title"] = "Dịch vụ"; }
<div class="app-page-toolbar">
    <span></span>
    <a class="btn btn-primary" asp-page="Create">Thêm dịch vụ</a>
</div>
<table class="table table-hover">
    <thead><tr><th>Tên</th><th>Đơn giá</th><th>ĐVT</th><th>Trạng thái</th><th></th></tr></thead>
    <tbody>
    @foreach (var d in Model.Items) {
        <tr>
            <td>@d.TenDichVu</td><td>@d.DonGia.ToString("N0")</td><td>@d.DonViTinh</td>
            <td>@(d.TrangThai ? "Bật" : "Tắt")</td>
            <td><a asp-page="Edit" asp-route-id="@d.DichVuId">Sửa</a></td>
        </tr>
    }
    </tbody>
</table>
