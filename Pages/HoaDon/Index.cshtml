@page "/HoaDon"
@model QuanLyNhaTro.Pages.HoaDon.IndexModel
@{ ViewData["Title"] = "Hóa đơn"; }

<div class="app-page-toolbar">
    <form method="get" class="d-flex flex-wrap gap-2">
        <input name="thang" value="@Model.Thang" class="form-control form-control-sm" placeholder="Tháng" style="width:80px" />
        <input name="nam" value="@Model.Nam" class="form-control form-control-sm" placeholder="Năm" style="width:90px" />
        <select name="trangThai" class="form-select form-select-sm" style="width:180px">
            <option value="">Tất cả</option>
            <option value="ChuaThanhToan">Chưa thanh toán</option>
            <option value="ThanhToanMotPhan">Thanh toán một phần</option>
            <option value="DaThanhToan">Đã thanh toán</option>
            <option value="QuaHan">Quá hạn</option>
        </select>
        <button class="btn btn-sm btn-outline-secondary" type="submit">Lọc</button>
    </form>
    <a class="btn btn-primary" asp-page="Create"><i class="bi bi-plus-lg me-1"></i>Lập hóa đơn</a>
</div>

<table class="table table-hover align-middle">
    <thead><tr><th>Phòng</th><th>Kỳ</th><th>Tổng</th><th>Đã thu</th><th>Còn nợ</th><th>TT</th><th></th></tr></thead>
    <tbody>
    @foreach (var h in Model.Items)
    {
        <tr>
            <td>@h.Phong.TenPhong</td>
            <td>@h.Thang/@h.Nam</td>
            <td>@h.TongTien.ToString("N0")</td>
            <td>@h.DaThanhToan.ToString("N0")</td>
            <td>@h.ConNo.ToString("N0")</td>
            <td>@h.TrangThai</td>
            <td class="text-end text-nowrap">
                <a class="btn btn-sm btn-outline-secondary" asp-page="Details" asp-route-id="@h.HoaDonId">Chi tiết</a>
                <a class="btn btn-sm btn-outline-primary" asp-page="Edit" asp-route-id="@h.HoaDonId">Sửa</a>
                <a class="btn btn-sm btn-outline-success" asp-page="/ThanhToan/Create" asp-route-hoaDonId="@h.HoaDonId">Thu tiền</a>
            </td>
        </tr>
    }
    </tbody>
</table>
