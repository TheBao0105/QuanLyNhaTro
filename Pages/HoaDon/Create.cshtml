@page "/HoaDon/Create"
@model QuanLyNhaTro.Pages.HoaDon.CreateModel
@{ ViewData["Title"] = "Lập hóa đơn"; }

<article class="app-card col-md-6">
    <p class="text-app-muted small">Hệ thống tự lấy tiền phòng từ hợp đồng, điện nước từ chỉ số, và các dịch vụ đang bật.</p>
    <form method="post">
        <div asp-validation-summary="All" class="text-danger mb-3"></div>
        <p class="mb-3">
            <label class="form-label">Phòng</label>
            <select asp-for="PhongId" asp-items="Model.PhongSelect" class="form-select">
                <option value="0">— Chọn phòng —</option>
            </select>
            <span asp-validation-for="PhongId" class="text-danger"></span>
        </p>
        <p class="mb-3">
            <label asp-for="Thang" class="form-label d-inline-block me-2"></label>
            <input asp-for="Thang" class="form-control d-inline-block w-auto" />
            <label asp-for="Nam" class="form-label d-inline-block ms-3 me-2"></label>
            <input asp-for="Nam" class="form-control d-inline-block w-auto" />
        </p>
        <button type="submit" class="btn btn-primary">Tạo hóa đơn</button>
        <a class="btn btn-outline-secondary" asp-page="Index">Hủy</a>
    </form>
</article>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
