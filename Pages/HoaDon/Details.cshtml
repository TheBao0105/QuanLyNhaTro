@page "/HoaDon/Details/{id:int}"
@model QuanLyNhaTro.Pages.HoaDon.DetailsModel
@{
    ViewData["Title"] = "Chi tiết hóa đơn";
    var h = Model.Invoice!;
}

<h1 class="h3 mb-3">@ViewData["Title"]</h1>

<dl class="row col-md-8">
    <dt class="col-sm-3">Phòng</dt><dd class="col-sm-9">@h.Phong.TenPhong</dd>
    <dt class="col-sm-3">Người thuê</dt><dd class="col-sm-9">@(Model.NguoiThueHoTen ?? "—")</dd>
    <dt class="col-sm-3">Kỳ</dt><dd class="col-sm-9">@h.Thang/@h.Nam</dd>
    <dt class="col-sm-3">Tiền phòng</dt><dd class="col-sm-9">@h.TienPhong.ToString("N0") đ</dd>
    <dt class="col-sm-3">Điện</dt><dd class="col-sm-9">@h.TienDien.ToString("N0") đ</dd>
    <dt class="col-sm-3">Nước</dt><dd class="col-sm-9">@h.TienNuoc.ToString("N0") đ</dd>
    <dt class="col-sm-3">Dịch vụ</dt><dd class="col-sm-9">@h.TienDichVu.ToString("N0") đ</dd>
    <dt class="col-sm-3">Tổng</dt><dd class="col-sm-9"><strong>@h.TongTien.ToString("N0") đ</strong></dd>
    <dt class="col-sm-3">Trạng thái</dt><dd class="col-sm-9">@h.TrangThai</dd>
    <dt class="col-sm-3">Ngày lập</dt><dd class="col-sm-9">@h.NgayLap.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</dd>
</dl>

<h2 class="h5 mt-4">Thanh toán</h2>
<table class="table table-sm">
    <thead><tr><th>Ngày</th><th>Số tiền</th><th>Phương thức</th><th>Ghi chú</th></tr></thead>
    <tbody>
    @foreach (var t in h.ThanhToans.OrderByDescending(x => x.NgayThanhToan))
    {
        <tr>
            <td>@t.NgayThanhToan.ToLocalTime().ToString("dd/MM/yyyy")</td>
            <td>@t.SoTien.ToString("N0") đ</td>
            <td>@t.PhuongThuc</td>
            <td>@t.GhiChu</td>
        </tr>
    }
    </tbody>
</table>

<a class="btn btn-outline-primary" asp-page="Edit" asp-route-id="@h.HoaDonId">Sửa</a>
<a class="btn btn-outline-secondary" asp-page="Index">Danh sách</a>
