        <a class="nav-link @Active("/Phong")" asp-page="/Phong/Index"><i class="bi bi-door-open me-2"></i>Quản lý phòng</a>
        <a class="nav-link @Active("/NguoiThue")" asp-page="/NguoiThue/Index"><i class="bi bi-people me-2"></i>Người thuê</a>
        <a class="nav-link @Active("/HopDong")" asp-page="/HopDong/Index"><i class="bi bi-file-earmark-text me-2"></i>Hợp đồng</a>
