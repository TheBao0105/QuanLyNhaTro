<!DOCTYPE html>
<html lang="vi" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - QuanLyNhaTro</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/QuanLyNhaTro.styles.css" asp-append-version="true" />
</head>
<body class="app-body">
@if (User.Identity?.IsAuthenticated == true && !ViewData.ContainsKey("HideSidebar"))
{
    <div class="app-shell">
        <partial name="_Sidebar" />
        <div class="app-content">
            <header class="app-topbar px-4 py-3 d-flex justify-content-between align-items-center">
                <span class="h5 mb-0 app-page-title">@ViewData["Title"]</span>
                <span class="text-app-muted small"><i class="bi bi-person-badge me-1"></i>@User.Identity?.Name</span>
            </header>
            <main class="px-4 pb-4 app-main">
                @RenderBody()
            </main>
        </div>
    </div>
}
else
{
    <main class="container py-4 app-main">
        @RenderBody()
    </main>
}

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
