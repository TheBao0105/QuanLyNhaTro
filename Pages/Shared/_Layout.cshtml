<!DOCTYPE html>
<html lang="vi" data-bs-theme="light" class="h-100">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - QuanLyNhaTro</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/QuanLyNhaTro.styles.css" asp-append-version="true" />
</head>
<body class="app-body">
    <header>
        <nav class="navbar navbar-expand-sm navbar-dark app-navbar mb-0">
            <div class="container app-container">
                <a class="navbar-brand d-flex align-items-center gap-2" asp-area="" asp-page="/Index">
                    <span class="rounded-2 d-inline-flex align-items-center justify-content-center bg-white bg-opacity-15" style="width:2rem;height:2rem;">
                        <i class="bi bi-building-check text-white"></i>
                    </span>
                    QuanLyNhaTro
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#appNav" aria-controls="appNav"
                        aria-expanded="false" aria-label="Mở menu">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div id="appNav" class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1 align-items-sm-center gap-sm-1 mt-2 mt-sm-0">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item"><a class="nav-link" asp-page="/Dashboard/Index"><i class="bi bi-speedometer2 me-1"></i>Dashboard</a></li>
                            <li class="nav-item"><a class="nav-link" asp-page="/Phong/Index"><i class="bi bi-door-open me-1"></i>Phòng</a></li>
                            <li class="nav-item"><a class="nav-link" asp-page="/NguoiThue/Index"><i class="bi bi-people me-1"></i>Người thuê</a></li>
                            <li class="nav-item"><a class="nav-link" asp-page="/HopDong/Index"><i class="bi bi-file-earmark-text me-1"></i>Hợp đồng</a></li>
                            <li class="nav-item"><a class="nav-link" asp-page="/HoaDon/Index"><i class="bi bi-receipt me-1"></i>Hóa đơn</a></li>
                            <li class="nav-item"><a class="nav-link" asp-page="/TaiKhoan/Profile"><i class="bi bi-person-circle me-1"></i>Hồ sơ</a></li>
                        }
                        else
                        {
                            <li class="nav-item"><a class="nav-link" asp-area="" asp-page="/Index"><i class="bi bi-house me-1"></i>Trang chủ</a></li>
                            <li class="nav-item"><a class="nav-link" asp-page="/TaiKhoan/Login"><i class="bi bi-box-arrow-in-right me-1"></i>Đăng nhập</a></li>
                            <li class="nav-item"><a class="nav-link" asp-page="/TaiKhoan/Register"><i class="bi bi-person-plus me-1"></i>Đăng ký</a></li>
                        }
                        <li class="nav-item"><a class="nav-link" asp-area="" asp-page="/Privacy"><i class="bi bi-shield-check me-1"></i>Privacy</a></li>
                    </ul>
                    <ul class="navbar-nav ms-md-3 ps-md-3 mt-2 mt-md-0 border-start border-white border-opacity-25">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item d-flex align-items-center flex-wrap gap-2">
                                <span class="navbar-text small"><i class="bi bi-person-badge me-1"></i>@User.Identity?.Name</span>
                                <a class="nav-link py-1" asp-page="/TaiKhoan/Logout"><i class="bi bi-box-arrow-right me-1"></i>Đăng xuất</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container app-container py-4 py-md-5 flex-grow-1">
        <main role="main" class="app-main">
            @RenderBody()
        </main>
    </div>

    <footer class="app-footer footer">
        <div class="container app-container">
            &copy; 2026 QuanLyNhaTro — <a asp-area="" asp-page="/Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
