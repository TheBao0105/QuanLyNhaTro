@page "/Dashboard"
@model QuanLyNhaTro.Pages.Dashboard.IndexModel
@{
    ViewData["Title"] = "Dashboard";
    var s = Model.Stats;
}

<div class="row g-3 stat-grid mb-4">
    <div class="col-6 col-md-4 col-xl-2">
        <div class="card stat-card border-0"><div class="card-body"><p class="stat-label">Tổng phòng</p><p class="stat-value">@s.TongPhong</p></div></div>
    </div>
    <div class="col-6 col-md-4 col-xl-2">
        <div class="card stat-card stat-card--slate border-0"><div class="card-body"><p class="stat-label">Trống</p><p class="stat-value">@s.PhongTrong</p></div></div>
    </div>
    <div class="col-6 col-md-4 col-xl-2">
        <div class="card stat-card border-0"><div class="card-body"><p class="stat-label">Đang thuê</p><p class="stat-value">@s.PhongDangThue</p></div></div>
    </div>
    <div class="col-6 col-md-4 col-xl-2">
        <div class="card stat-card stat-card--amber border-0"><div class="card-body"><p class="stat-label">Bảo trì</p><p class="stat-value">@s.PhongBaoTri</p></div></div>
    </div>
    <div class="col-6 col-md-4 col-xl-2">
        <div class="card stat-card border-0"><div class="card-body"><p class="stat-label">Người thuê</p><p class="stat-value">@s.TongNguoiThue</p></div></div>
    </div>
    <div class="col-6 col-md-4 col-xl-2">
        <div class="card stat-card stat-card--rose border-0"><div class="card-body"><p class="stat-label">HĐ hiệu lực</p><p class="stat-value">@s.HopDongHieuLuc</p></div></div>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-4"><div class="app-card"><p class="text-app-muted small mb-1">Doanh thu tháng</p><p class="fs-4 fw-bold mb-0">@s.DoanhThuThang.ToString("N0") đ</p></div></div>
    <div class="col-md-4"><div class="app-card"><p class="text-app-muted small mb-1">Doanh thu năm</p><p class="fs-4 fw-bold mb-0">@s.DoanhThuNam.ToString("N0") đ</p></div></div>
    <div class="col-md-4"><div class="app-card"><p class="text-app-muted small mb-1">Tổng công nợ</p><p class="fs-4 fw-bold text-danger mb-0">@s.TongNo.ToString("N0") đ</p></div></div>
</div>

<div class="row g-3">
    <div class="col-lg-6">
        <div class="app-card">
            <h2 class="h6 mb-3">Hợp đồng sắp hết hạn</h2>
            <table class="table table-sm mb-0">
                <thead><tr><th>Phòng</th><th>Người thuê</th><th>Hết hạn</th></tr></thead>
                <tbody>
                @foreach (var h in s.HopDongSapHetHan)
                {
                    <tr><td>@h.TenPhong</td><td>@h.TenNguoiThue</td><td>@h.NgayKetThuc?.ToString("dd/MM/yyyy")</td></tr>
                }
                </tbody>
            </table>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="app-card">
            <h2 class="h6 mb-3">Hóa đơn quá hạn / chưa thu</h2>
            <table class="table table-sm mb-0">
                <thead><tr><th>Phòng</th><th>Kỳ</th><th>Còn nợ</th></tr></thead>
                <tbody>
                @foreach (var h in s.HoaDonQuaHan)
                {
                    <tr><td>@h.TenPhong</td><td>@h.Thang/@h.Nam</td><td>@h.ConNo.ToString("N0") đ</td></tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>
