@page "/Phong/Details/{id:int}"
@model QuanLyNhaTro.Pages.Phong.DetailsModel
@{
    ViewData["Title"] = "Chi tiết phòng";
    var p = Model.Phong!;
}

<h1 class="h3 mb-3">@ViewData["Title"]</h1>

<dl class="row col-md-8">
    <dt class="col-sm-3">Tên phòng</dt><dd class="col-sm-9">@p.TenPhong</dd>
    <dt class="col-sm-3">Mô tả</dt><dd class="col-sm-9">@p.MoTa</dd>
    <dt class="col-sm-3">Giá thuê</dt><dd class="col-sm-9">@p.GiaThue.ToString("N0") đ</dd>
    <dt class="col-sm-3">Diện tích</dt><dd class="col-sm-9">@p.DienTichM2 m²</dd>
    <dt class="col-sm-3">Trạng thái</dt><dd class="col-sm-9">@p.TrangThai</dd>
</dl>

<h2 class="h5 mt-4">Hợp đồng liên quan</h2>
<table class="table table-sm">
    <thead><tr><th>Người thuê</th><th>Từ ngày</th><th>Trạng thái</th></tr></thead>
    <tbody>
    @foreach (var h in p.HopDongs.OrderByDescending(x => x.NgayBatDau))
    {
        <tr>
            <td>@h.NguoiThue.HoTen</td>
            <td>@h.NgayBatDau.ToString("dd/MM/yyyy")</td>
            <td>@h.TrangThai</td>
        </tr>
    }
    </tbody>
</table>

<a class="btn btn-outline-primary" asp-page="Edit" asp-route-id="@p.Id">Sửa</a>
<a class="btn btn-outline-secondary" asp-page="Index">Danh sách</a>
