@page "/Phong"
@model QuanLyNhaTro.Pages.Phong.IndexModel
@{
    ViewData["Title"] = "Quản lý phòng";
}

@if (TempData["Success"] != null) { <div class="alert alert-success">@TempData["Success"]</div> }
@if (TempData["Error"] != null) { <div class="alert alert-danger">@TempData["Error"]</div> }

<div class="app-page-toolbar">
    <form method="get" class="d-flex flex-wrap gap-2 align-items-center">
        <input name="Q" value="@Model.Q" class="form-control form-control-sm" placeholder="Tìm tên phòng..." style="width:200px" />
        <select name="TrangThai" class="form-select form-select-sm" style="width:160px">
            <option value="">Tất cả trạng thái</option>
            <option value="ConTrong" selected="@(Model.TrangThai=="ConTrong")">Còn trống</option>
            <option value="DangThue" selected="@(Model.TrangThai=="DangThue")">Đang thuê</option>
            <option value="BaoTri" selected="@(Model.TrangThai=="BaoTri")">Bảo trì</option>
        </select>
        <button type="submit" class="btn btn-sm btn-outline-secondary">Lọc</button>
    </form>
    <a class="btn btn-primary" asp-page="Create"><i class="bi bi-plus-lg me-1"></i>Thêm phòng</a>
</div>

<table class="table table-hover align-middle">
    <thead><tr><th>Tên</th><th>Giá thuê</th><th>DT (m²)</th><th>Số người</th><th>Trạng thái</th><th></th></tr></thead>
    <tbody>
    @foreach (var p in Model.Items)
    {
        <tr>
            <td>@p.TenPhong</td>
            <td>@p.GiaThue.ToString("N0") đ</td>
            <td>@p.DienTich</td>
            <td>@p.SoNguoiToiDa</td>
            <td><span class="badge text-bg-light border">@p.TrangThai</span></td>
            <td class="text-end text-nowrap">
                <a class="btn btn-sm btn-outline-secondary" asp-page="Details" asp-route-id="@p.PhongId">Chi tiết</a>
                <a class="btn btn-sm btn-outline-primary" asp-page="Edit" asp-route-id="@p.PhongId">Sửa</a>
                <form method="post" asp-page-handler="Delete" asp-route-id="@p.PhongId" class="d-inline" onsubmit="return confirm('Xóa phòng?');">
                    <button type="submit" class="btn btn-sm btn-outline-danger">Xóa</button>
                </form>
            </td>
        </tr>
    }
    </tbody>
</table>
