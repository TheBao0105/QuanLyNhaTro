@page "/Phong"
@model QuanLyNhaTro.Pages.Phong.IndexModel
@{
    ViewData["Title"] = "Phòng";
}

<div class="app-page-toolbar">
    <h1 class="h3 app-page-title mb-0">Danh sách phòng</h1>
    <a class="btn btn-primary" asp-page="Create"><i class="bi bi-plus-lg me-1"></i>Thêm phòng</a>
</div>

<table class="table table-striped table-bordered align-middle">
    <thead class="table-light">
        <tr>
            <th>Tên phòng</th>
            <th>Giá thuê</th>
            <th>Diện tích (m²)</th>
            <th>Trạng thái</th>
            <th style="width:220px"></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var p in Model.Items)
    {
        <tr>
            <td>@p.TenPhong</td>
            <td>@p.GiaThue.ToString("N0") đ</td>
            <td>@p.DienTichM2</td>
            <td>@p.TrangThai</td>
            <td>
                <a class="btn btn-sm btn-outline-secondary" asp-page="Details" asp-route-id="@p.Id">Chi tiết</a>
                <a class="btn btn-sm btn-outline-primary" asp-page="Edit" asp-route-id="@p.Id">Sửa</a>
                <a class="btn btn-sm btn-outline-danger" asp-page="Delete" asp-route-id="@p.Id">Xóa</a>
            </td>
        </tr>
    }
    </tbody>
</table>
