@page "/ThanhToan/Create"
@model QuanLyNhaTro.Pages.ThanhToan.CreateModel
@{
    ViewData["Title"] = "Ghi nhận thanh toán";
}

<article class="app-card col-md-6">
    @if (Model.HoaDonInfo != null)
    {
        <p class="alert alert-info py-2">Còn nợ: <strong>@Model.HoaDonInfo.ConNo.ToString("N0") đ</strong></p>
    }
    <form method="post">
        <div asp-validation-summary="All" class="text-danger mb-3"></div>
        <p class="mb-3">
            <label class="form-label">Hóa đơn</label>
            <select asp-for="ThanhToan.HoaDonId" asp-items="Model.HoaDonSelect" class="form-select"></select>
        </p>
        <p class="mb-3">
            <label asp-for="ThanhToan.SoTien" class="form-label"></label>
            <input asp-for="ThanhToan.SoTien" class="form-control" />
        </p>
        <p class="mb-3">
            <label asp-for="ThanhToan.PhuongThuc" class="form-label"></label>
            <select asp-for="ThanhToan.PhuongThuc" class="form-select">
                <option value="TienMat">Tiền mặt</option>
                <option value="ChuyenKhoan">Chuyển khoản</option>
            </select>
        </p>
        <p class="mb-3">
            <label asp-for="ThanhToan.GhiChu" class="form-label"></label>
            <textarea asp-for="ThanhToan.GhiChu" class="form-control" rows="2"></textarea>
        </p>
        <button type="submit" class="btn btn-primary">Lưu</button>
        <a asp-page="Index" class="btn btn-outline-secondary">Hủy</a>
    </form>
</article>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}