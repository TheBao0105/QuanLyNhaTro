@page "/TaiKhoan/Login"
@model QuanLyNhaTro.Pages.TaiKhoan.LoginModel
@{
    ViewData["Title"] = "Đăng nhập";
    ViewData["HideSidebar"] = true;
}

<div class="row justify-content-center py-4">
    <div class="col-md-5 col-lg-4">
        <div class="auth-panel">
            <h1 class="h4 text-center mb-4">Đăng nhập hệ thống</h1>
            <form method="post">
                <div asp-validation-summary="All" class="text-danger small mb-3"></div>
                <div class="mb-3">
                    <label asp-for="Input.TenDangNhap" class="form-label"></label>
                    <input asp-for="Input.TenDangNhap" class="form-control" autocomplete="username" />
                </div>
                <div class="mb-4">
                    <label asp-for="Input.MatKhau" class="form-label"></label>
                    <input asp-for="Input.MatKhau" type="password" class="form-control" autocomplete="current-password" />
                </div>
                <button type="submit" class="btn btn-primary w-100">Đăng nhập</button>
            </form>
            <p class="small text-center text-app-muted mt-3 mb-0">Mẫu: <code>admin</code> / <code>Admin@123</code></p>
        </div>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
