@page "/TaiKhoan/Register"
@model QuanLyNhaTro.Pages.TaiKhoan.RegisterModel
@{
    ViewData["Title"] = "Đăng ký";
}

<div class="row justify-content-center py-2">
    <div class="col-md-6 col-lg-5">
        <div class="auth-panel">
            <div class="text-center mb-4">
                <span class="d-inline-flex align-items-center justify-content-center rounded-3 mb-2" style="width:3rem;height:3rem;background:var(--ql-primary-soft);color:var(--ql-primary-dark);">
                    <i class="bi bi-person-plus fs-4"></i>
                </span>
                <h1 class="h4 mb-1">@ViewData["Title"]</h1>
                <p class="text-app-muted small mb-0">Tạo tài khoản chủ trọ</p>
            </div>
            <form method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>
                <div class="mb-3">
                    <label asp-for="TenDangNhap" class="form-label"></label>
                    <input asp-for="TenDangNhap" class="form-control" autocomplete="username" />
                    <span asp-validation-for="TenDangNhap" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="HoTen" class="form-label">Họ tên</label>
                    <input asp-for="HoTen" class="form-control" />
                    <span asp-validation-for="HoTen" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="MatKhau" class="form-label"></label>
                    <input asp-for="MatKhau" class="form-control" autocomplete="new-password" />
                    <span asp-validation-for="MatKhau" class="text-danger small"></span>
                </div>
                <div class="mb-4">
                    <label asp-for="MatKhauNhapLai" class="form-label">Nhập lại mật khẩu</label>
                    <input asp-for="MatKhauNhapLai" class="form-control" autocomplete="new-password" />
                    <span asp-validation-for="MatKhauNhapLai" class="text-danger small"></span>
                </div>
                <div class="d-grid gap-2">
                    <button type="submit" class="btn btn-primary py-2"><i class="bi bi-check2-circle me-2"></i>Đăng ký</button>
                    <a class="btn btn-outline-secondary" asp-page="Login"><i class="bi bi-arrow-left me-2"></i>Đã có tài khoản?</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
