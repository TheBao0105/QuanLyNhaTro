@page "/NguoiThue/Edit/{id:int}"
@model QuanLyNhaTro.Pages.NguoiThue.EditModel
@{
    ViewData["Title"] = "Sửa người thuê";
}

<h1 class="h3 mb-3">@ViewData["Title"]</h1>

<form method="post" class="col-md-6">
    <input type="hidden" asp-for="NguoiThue.NguoiThueId" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="mb-3">
        <label asp-for="NguoiThue.HoTen" class="form-label"></label>
        <input asp-for="NguoiThue.HoTen" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="NguoiThue.CCCD" class="form-label">CCCD</label>
        <input asp-for="NguoiThue.CCCD" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="NguoiThue.SoDienThoai" class="form-label">Số điện thoại</label>
        <input asp-for="NguoiThue.SoDienThoai" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="NguoiThue.Email" class="form-label"></label>
        <input asp-for="NguoiThue.Email" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="NguoiThue.DiaChi" class="form-label">Địa chỉ</label>
        <textarea asp-for="NguoiThue.DiaChi" class="form-control" rows="2"></textarea>
    </div>
    <button type="submit" class="btn btn-primary">Cập nhật</button>
    <a class="btn btn-outline-secondary" asp-page="Index">Quay lại</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
