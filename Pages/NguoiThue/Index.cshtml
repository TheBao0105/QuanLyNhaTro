@page "/NguoiThue"
@model QuanLyNhaTro.Pages.NguoiThue.IndexModel
@{
    ViewData["Title"] = "Người thuê";
}

<div class="app-page-toolbar">
    <h1 class="h3 app-page-title mb-0">Danh sách người thuê</h1>
    <a class="btn btn-primary" asp-page="Create"><i class="bi bi-person-plus me-1"></i>Thêm người thuê</a>
</div>

<table class="table table-striped table-bordered align-middle">
    <thead class="table-light">
        <tr>
            <th>Họ tên</th>
            <th>SĐT</th>
            <th>Email</th>
            <th style="width:220px"></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var n in Model.Items)
    {
        <tr>
            <td>@n.HoTen</td>
            <td>@n.SoDienThoai</td>
            <td>@n.Email</td>
            <td>
                <a class="btn btn-sm btn-outline-secondary" asp-page="Details" asp-route-id="@n.Id">Chi tiết</a>
                <a class="btn btn-sm btn-outline-primary" asp-page="Edit" asp-route-id="@n.Id">Sửa</a>
                <a class="btn btn-sm btn-outline-danger" asp-page="Delete" asp-route-id="@n.Id">Xóa</a>
            </td>
        </tr>
    }
    </tbody>
</table>
